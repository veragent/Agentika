{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.open-next/assets"
  },
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "0bb0cfe625fd4f06bda2ad097d07e6de"
    }
  ],
  "main": ".open-next/worker.js",
  "name": "agentika-staging",
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "agentika-staging-inc-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "agentika-staging"
    }
  ],
  "vars": {
    "AI_BASE_URL": "https://api.cloudflare.com/client/v4/accounts/39058c7c1fe9230c935b19991fa373fe/ai/v1",
    "AI_CHAT_ENABLED": "true",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_WRITER_ENABLED": "true",
    "NEWSLETTER_FROM_EMAIL": "halo@agentika.web.id",
    "NEWSLETTER_LIST_ID": "c63c6498-d392-4978-8c5d-9e71b23fc41f",
    "NEWSLETTER_PROVIDER": "resend",
    "NEXT_PUBLIC_ADSENSE_CLIENT": "ca-pub-8284519503817385",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-CF8K7Z0DVD",
    "NEXT_PUBLIC_GSC_VERIFICATION": "8znXHfnNXhcz-iuVquIAPQprKVsEltoGWSWLFi0OBBQ",
    "PROMPT_GENERATOR_ENABLED": "true",
    "UPSTASH_REDIS_REST_URL": "https://optimal-cub-129008.upstash.io"
  },
  "workers_dev": true
}