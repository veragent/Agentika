# ===============================================
# AGENTIKA — Environment Variables
# ================================================
# Copy to .env.local for development: cp .env.example .env.local
#
# Modes:
#   development — local dev
#   staging     — preview/UAT
#   production  — live, all secrets via deploy platform (e.g. Netlify)
# ================================================

# Runtime mode
NODE_ENV="development"

# ---- AI Provider generik (OpenAI-compatible; dipakai AI Chat & AI Writer) ----
# Ganti provider cukup ganti 3 nilai ini, tanpa ubah kode.
# Default: Hcnsec + MiniMax-M3.1-Flash (gratis di bawah tier 200K
# per panggilan, limit default 950 req/menit di akun Hcnsec).
AI_BASE_URL="https://api.hcnsec.cn/v1"
AI_API_KEY=""
AI_MODEL="MiniMax-M3.1-Flash"

# ---- Upstash Redis (store bersama: rate limit + cache respons AI) ----
# Buat database di Upstash Console, salin REST URL + token ke sini dan
# ke env Vercel. Kosong = fallback in-memory per instance (tetap jalan,
# tapi rate limit/cache tidak berlaku lintas instance serverless).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- AI Providers lama (tidak dipakai provider generik di atas) ----
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
GROQ_API_KEY=""

# ---- Monetization ----
NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXX"

# ---- Analytics ----
# Google Analytics 4 (works everywhere: Netlify, Vercel, Cloudflare, etc.)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# Google Search Console verification
NEXT_PUBLIC_GSC_VERIFICATION="google-site-verification-token"

# Note: Netlify Analytics is enabled in Netlify Dashboard (Site Settings → Analytics)
# No code changes needed — $9/mo, server-side, no cookies.

# ---- Email (Resend) ----
RESEND_API_KEY=

# ---- Discord ----
# Discord webhook URL for announcements (create in Discord channel settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=

# ---- Telegram ----
# Create bot via @BotFather and get the token
TELEGRAM_BOT_TOKEN=
# Your admin Telegram chat ID (for testing) - get via @userinfobot
TELEGRAM_ADMIN_CHAT_ID=
# Telegram channel ID for announcements (e.g., -1001234567890 for channels)
TELEGRAM_ANNOUNCEMENTS_CHANNEL_ID=

# ---- Newsletter ----
# Provider: convertkit | mailerlite | buttondown | mailchimp | resend
NEWSLETTER_PROVIDER=your_newsletter_provider_here
NEWSLETTER_API_KEY=""
NEWSLETTER_FORM_ID=""      # ConvertKit form ID, MailerLite group ID
NEWSLETTER_LIST_ID=""      # Mailchimp list ID, Resend audience ID
NEWSLETTER_FROM_EMAIL=""   # Pengirim welcome email + digest, mis. "Agentika <halo@agentika.web.id>" (domain harus terverifikasi di Resend)
CRON_SECRET=""             # Bearer token pelindung /api/newsletter/digest (atur juga di Vercel Cron)

# ---- Giscus (komentar blog, opsional) ----
# Isi setelah GitHub Discussions aktif di repo dan app Giscus terpasang; ambil nilainya dari giscus.app
NEXT_PUBLIC_GISCUS_REPO=""
NEXT_PUBLIC_GISCUS_REPO_ID=""
NEXT_PUBLIC_GISCUS_CATEGORY=""
NEXT_PUBLIC_GISCUS_CATEGORY_ID=""

# ---- App URL (for sitemap, OG, canonical) ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"