# ===============================================
# AGENTIKA — Environment Variables
# ================================================
# Copy to .env.local for development: cp .env.example .env.local
#
# Modes:
#   development — local dev
#   staging     — preview/UAT (Worker agentika-staging)
#   production  — live di Cloudflare Workers; semua secret diisi lewat
#                 dashboard Cloudflare (wrangler secret put), bukan .env
# ================================================

# Runtime mode
NODE_ENV="development"

# ---- AI Provider generik (OpenAI-compatible; dipakai AI Chat & AI Writer) ----
# Ganti provider cukup ganti 3 nilai ini, tanpa ubah kode.
# Default: Hcnsec + MiniMax-M3.1-Flash.
# Produksi memakai Workers AI (Llama 3.3 70B) — AI_API_KEY produksi adalah
# token Workers AI Write, diisi sebagai secret Worker, bukan di sini.
AI_BASE_URL="https://api.hcnsec.cn/v1"
AI_API_KEY=""
AI_MODEL="MiniMax-M3.1-Flash"

# ---- Kill switches AI (isi "true" untuk mengaktifkan) ----
AI_CHAT_ENABLED="false"
AI_WRITER_ENABLED="false"
PROMPT_GENERATOR_ENABLED="false"

# ---- Provider AI lama (legacy) ----
# Hanya dipakai pengecekan ketersediaan Prompt Generator; provider generik
# di atas tidak butuh key-key ini. Boleh dikosongkan.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
GROQ_API_KEY=""

# ---- Upstash Redis (store bersama: rate limit + cache respons AI) ----
# Kosong = fallback in-memory per instance (tetap jalan, tapi rate limit /
# cache tidak berlaku lintas instance).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Monetisasi ----
NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXX"

# ---- Analytics ----
# Google Analytics 4. Nama lama NEXT_PUBLIC_GA_ID juga masih dibaca
# layout.tsx sebagai fallback, tapi pakai nama ini.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# Google Search Console verification — WAJIB ter-export SEBELUM build,
# karena meta verifikasi dibentuk saat build.
NEXT_PUBLIC_GSC_VERIFICATION=""

# ---- Email (Resend) ----
# Newsletter memakai REST API Resend langsung (fetch), bukan SDK.
RESEND_API_KEY=""

# ---- Newsletter ----
# Provider: convertkit | mailerlite | buttondown | mailchimp | resend
NEWSLETTER_PROVIDER="resend"
NEWSLETTER_API_KEY=""
NEWSLETTER_FORM_ID=""
NEWSLETTER_LIST_ID=""
NEWSLETTER_FROM_EMAIL=""
# Bearer token pelindung /api/newsletter/digest
CRON_SECRET=""

# ---- Giscus (komentar blog, opsional) ----
# Isi setelah GitHub Discussions aktif di repo dan app Giscus terpasang; ambil nilainya dari giscus.app
NEXT_PUBLIC_GISCUS_REPO=""
NEXT_PUBLIC_GISCUS_REPO_ID=""
NEXT_PUBLIC_GISCUS_CATEGORY=""
NEXT_PUBLIC_GISCUS_CATEGORY_ID=""

# ---- App URL (for sitemap, OG, canonical) ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
